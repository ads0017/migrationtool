import React, { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Select, SelectItem } from "@/components/ui/select";

const criteria = [
  "Business Criticality",
  "Migration Readiness",
  "HCI Compatibility",
  "Public Cloud Suitability",
  "Latency Sensitivity",
  "Data Sovereignty & Compliance",
  "Infrastructure Dependencies",
  "Operational Complexity",
  "Cost Efficiency",
];

const migrationOptions = [
  { label: "Rehost (Lift-and-Shift)", range: [0, 20], target: "HCI or Public Cloud (IaaS)" },
  { label: "Replatform (Lift-Tinker-and-Shift)", range: [21, 30], target: "HCI or Public Cloud (VMs/Containers)" },
  { label: "Refactor (Re-architect)", range: [31, 45], target: "Public Cloud (PaaS, Serverless, Kubernetes)" },
  { label: "Repurchase (Replace)", range: [10, 25], target: "SaaS" },
  { label: "Retain (Revisit Later)", range: [25, 40], target: "On-Prem HCI or Physical DC" },
  { label: "Retire (Decommission)", range: [0, 15], target: "Decommission" },
];

export default function MigrationCalculator() {
  const [scores, setScores] = useState(Array(criteria.length).fill(1));
  const [result, setResult] = useState(null);

  const handleChange = (index, value) => {
    const newScores = [...scores];
    newScores[index] = parseInt(value, 10);
    setScores(newScores);
  };

  const calculateMigration = () => {
    const totalScore = scores.reduce((acc, score) => acc + score, 0);
    const migrationChoice = migrationOptions.find(
      (option) => totalScore >= option.range[0] && totalScore <= option.range[1]
    );
    setResult(migrationChoice ? migrationChoice : { label: "Custom Evaluation Needed", target: "Hybrid Approach" });
  };

  return (
    <div className="p-4 max-w-lg mx-auto">
      <h1 className="text-xl font-bold mb-4">Hybrid Migration Decision Tool</h1>
      <Card>
        <CardContent>
          {criteria.map((criterion, index) => (
            <div key={index} className="mb-2">
              <label className="block text-sm font-medium">{criterion}</label>
              <Select onValueChange={(value) => handleChange(index, value)} defaultValue="1">
                {[1, 2, 3, 4, 5].map((val) => (
                  <SelectItem key={val} value={val.toString()}>{val}</SelectItem>
                ))}
              </Select>
            </div>
          ))}
          <Button className="mt-4 w-full" onClick={calculateMigration}>Calculate Best Location</Button>
          {result && (
            <div className="mt-4 p-2 border rounded-lg bg-gray-100">
              <h2 className="font-semibold">Recommended Approach: {result.label}</h2>
              <p>Target Environment: {result.target}</p>
            </div>
          )}
        </CardContent>
      </Card>
    </div>
  );
}
